<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_card_rounded"
    android:elevation="2dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp"
    tools:ignore="HardcodedText">

    <!-- Left Column: 4-Line Phrase Typography (Old Style Arrangement) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_phrase_en"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="15.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_phrase_vi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="@color/saigon_red"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_phrase_unaccented"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/text_muted"
            android:textSize="12.5sp" />

        <TextView
            android:id="@+id/tv_phrase_pronunciation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="@color/saigon_teal"
            android:textSize="12.5sp"
            android:textStyle="bold|italic" />

        <TextView
            android:id="@+id/tv_phrase_explanation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tv_phrase_category"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:background="@drawable/bg_lavender_pill"
            android:paddingStart="7dp"
            android:paddingTop="2dp"
            android:paddingEnd="7dp"
            android:paddingBottom="2dp"
            android:textColor="@color/text_secondary"
            android:textSize="10.5sp" />
    </LinearLayout>

    <!-- Right Column: Heart, Peach Circular Speaker Button, Slow & Flashcard Actions -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_phrase_delete_custom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:padding="2dp"
                android:text="🗑️"
                android:textSize="13sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/btn_phrase_save"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="2dp"
                android:text="🤍"
                android:textSize="16sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btn_phrase_speak_normal"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_peach_circle"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="🔊"
            android:textColor="@color/saigon_red"
            android:textSize="18sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_phrase_speak_slow"
                android:layout_width="28dp"
                android:layout_height="26dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_lavender_pill"
                android:gravity="center"
                android:text="🐢"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/btn_phrase_show_card"
                android:layout_width="28dp"
                android:layout_height="26dp"
                android:background="@drawable/bg_lavender_pill"
                android:gravity="center"
                android:text="📱"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
