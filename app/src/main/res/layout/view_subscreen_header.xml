<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/subscreen_toolbar"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:background="@drawable/bg_header_white_border"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingEnd="12dp"
    tools:ignore="HardcodedText">

    <TextView
        android:id="@+id/btn_toolbar_back"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="@drawable/bg_lavender_pill"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="←"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_toolbar_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Chi tiết"
        android:textColor="@color/saigon_red"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/btn_toolbar_action"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:background="@drawable/bg_peach_pill"
        android:gravity="center"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:text="Action"
        android:textColor="@color/saigon_red_dark"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone" />
</LinearLayout>
