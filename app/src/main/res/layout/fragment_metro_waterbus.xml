<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream_background"
    android:orientation="vertical"
    tools:ignore="HardcodedText">

    <include layout="@layout/view_subscreen_header" />

    <!-- Mode Switcher: Metro Line 1 vs Saigon Waterbus -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/tab_mode_metro"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_chip_sky_selected"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="🚇 Metro Số 1 (14 Ga)"
            android:textColor="@color/white"
            android:textSize="12.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tab_mode_waterbus"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:background="@drawable/bg_chip_unselected"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="⛴️ Waterbus Sông SG (5 Bến)"
            android:textColor="@color/text_primary"
            android:textSize="12.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:padding="14dp"
        android:paddingBottom="36dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Station A -> B Fare & Time Calculator Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_rounded"
                android:elevation="1dp"
                android:orientation="vertical"
                android:padding="15dp">

                <TextView
                    android:id="@+id/tv_transit_calc_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🧭 Tra cứu Lộ trình &amp; Giá vé Chặng A → B"
                    android:textColor="@color/text_primary"
                    android:textSize="15.5sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/btn_pick_from_station"
                            android:layout_width="match_parent"
                            android:layout_height="42dp"
                            android:background="@drawable/bg_stat_tile"
                            android:clickable="true"
                            android:ellipsize="end"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:maxLines="1"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:text="🟢 Đi: Ga Bến Thành ▾"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/btn_pick_to_station"
                            android:layout_width="match_parent"
                            android:layout_height="42dp"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/bg_stat_tile"
                            android:clickable="true"
                            android:ellipsize="end"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:maxLines="1"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:text="🏁 Đến: Ga Tân Cảng (Landmark 81) ▾"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/btn_swap_stations"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_teal_mint_pill"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="⇅"
                        android:textColor="@color/saigon_teal_dark"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Result Box -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_fx_result_gradient"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:id="@+id/tv_transit_route_summary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_transit_fare_main"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/saigon_gold_light"
                        android:textSize="13.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_transit_pass_note"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="#E6FFFFFF"
                        android:textSize="11.5sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btn_transit_open_dest_map"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_button_primary"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="🗺️ Bản đồ Ga đến"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btn_transit_open_landmark"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_button_teal"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="🏛️ Điểm chơi gần ga"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Line Map Header -->
            <TextView
                android:id="@+id/tv_transit_line_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                android:text="🚉 Sơ đồ Tuyến &amp; Kết nối Du lịch quanh Nhà ga"
                android:textColor="@color/text_primary"
                android:textSize="15.5sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/container_transit_stations"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
