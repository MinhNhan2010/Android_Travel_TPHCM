<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream_background"
    android:orientation="vertical"
    tools:ignore="HardcodedText">

    <include layout="@layout/view_subscreen_header" />

    <!-- Old-Style 3 Sub-Tab Chips Strip (Ride Apps & Taxis | Fare Estimator | Driver Cards) -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_header_white_border"
        android:clipToPadding="false"
        android:paddingStart="14dp"
        android:paddingTop="8dp"
        android:paddingEnd="14dp"
        android:paddingBottom="10dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tab_ride_apps"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_chip_selected"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="🚗 Ride Apps &amp; Taxis"
                android:textColor="@color/white"
                android:textSize="12.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tab_ride_estimator"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_chip_unselected"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="⏱️ Fare Estimator"
                android:textColor="@color/text_primary"
                android:textSize="12.5sp" />

            <TextView
                android:id="@+id/tab_ride_cards"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_chip_unselected"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="🗣️ Driver Cards"
                android:textColor="@color/text_primary"
                android:textSize="12.5sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:padding="14dp"
        android:paddingBottom="80dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- PANEL 1: Ride Apps & Taxis (Old Style Mint Advice Banner + Provider Cards) -->
            <LinearLayout
                android:id="@+id/panel_ride_apps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_ride_banner_mint"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:id="@+id/tv_ride_advice_header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🛡️ Tourist Anti-Scam &amp; Safe Taxi Rules"
                        android:textColor="@color/ride_green"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_ride_safety_rules"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:lineSpacingExtra="3dp"
                        android:textColor="@color/text_primary"
                        android:textSize="12.5sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/container_ride_providers"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- PANEL 2: Fare Estimator (White Calculator Card + Peach Distance Banner + 3 Vehicle Tiers) -->
            <LinearLayout
                android:id="@+id/panel_ride_estimator"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_rounded"
                    android:elevation="2dp"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🚕 Smart Fare &amp; Traffic Time Calculator"
                        android:textColor="@color/saigon_red"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_ride_pickup_label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="📍 Pickup Point:"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/container_pickup_chips"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal" />
                    </HorizontalScrollView>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="🏁 Destination:"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/et_ride_destination"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="5dp"
                        android:background="@drawable/bg_search_box"
                        android:hint="Destination..."
                        android:importantForAutofill="no"
                        android:inputType="text"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textSize="13.5sp" />
                </LinearLayout>

                <!-- Peach Summary Banner (Old Style #FFCCBC) -->
                <TextView
                    android:id="@+id/tv_ride_distance_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_peach_pill"
                    android:gravity="center"
                    android:padding="12dp"
                    android:textColor="@color/saigon_red_dark"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <!-- Vehicle Tier Cards Container -->
                <LinearLayout
                    android:id="@+id/container_fare_estimates"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- PANEL 3: Driver Flashcards (Teal-Mint Header + Bilingual Speaker Cards) -->
            <LinearLayout
                android:id="@+id/panel_ride_cards"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tv_driver_cards_banner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_teal_mint_pill"
                    android:padding="12dp"
                    android:text="🗣️ Show or Play Vietnamese Flashcards to Your Driver"
                    android:textColor="@color/saigon_teal_dark"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/container_driver_phrases"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
