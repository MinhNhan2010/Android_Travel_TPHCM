<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="18dp"
    tools:ignore="HardcodedText">

    <EditText
        android:id="@+id/et_custom_phrase_en"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@drawable/bg_search_box"
        android:hint="Câu Tiếng Anh (English meaning)"
        android:importantForAutofill="no"
        android:inputType="text"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/et_custom_phrase_vi"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_search_box"
        android:hint="Câu Tiếng Việt (Vietnamese phrase)"
        android:importantForAutofill="no"
        android:inputType="text"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/et_custom_phrase_pron"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_search_box"
        android:hint="Phiên âm dễ đọc (tùy chọn)"
        android:importantForAutofill="no"
        android:inputType="text"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/et_custom_phrase_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_search_box"
        android:hint="Ghi chú ngữ cảnh sử dụng (tùy chọn)"
        android:importantForAutofill="no"
        android:inputType="textMultiLine"
        android:minLines="2"
        android:padding="12dp"
        android:textSize="14sp" />
</LinearLayout>
