<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="12dp"
    tools:ignore="HardcodedText">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_dialog_card"
        android:elevation="8dp"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Tiêu đề hộp thoại Xác thực Google / Mạng xã hội (Phong cách gốc) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_oauth_brand_badge"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:gravity="center"
                    android:text="G"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_oauth_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="Đăng nhập Google (Gmail)"
                    android:textColor="@color/text_primary"
                    android:textSize="16.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btn_oauth_close"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:background="@drawable/bg_lavender_pill"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="✕"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Danh sách tài khoản thực tế đã liên kết trên thiết bị (chỉ hiện khi có trong SQLite) -->
            <LinearLayout
                android:id="@+id/box_oauth_saved_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tv_oauth_saved_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="Tài khoản đã liên kết trên máy (chạm để vào ngay):"
                    android:textColor="@color/text_secondary"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/container_oauth_accounts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="4dp"
                    android:background="@color/divider_color" />
            </LinearLayout>

            <!-- Nút mở lại Bộ chọn Tài khoản Google hệ thống của Android (chỉ hiện với Google) -->
            <TextView
                android:id="@+id/btn_oauth_pick_device_google"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_oauth_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="📱 Chọn tài khoản Google trên thiết bị"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- Dòng mô tả quyền Du khách Thành viên -->
            <TextView
                android:id="@+id/tv_oauth_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Xác thực nhanh bằng Google: tài khoản mới tự động nhận quyền Du khách Thành viên."
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <!-- Ô nhập Email / Số điện thoại Zalo / Tên tài khoản hiển thị trực tiếp -->
            <TextView
                android:id="@+id/tv_lbl_oauth_identifier"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="4dp"
                android:text="Địa chỉ Gmail (vd: ten@gmail.com)"
                android:textColor="@color/text_secondary"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/et_oauth_identifier"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_search_box"
                android:hint="ten@gmail.com"
                android:importantForAutofill="no"
                android:inputType="textEmailAddress"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:singleLine="true"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"
                android:textSize="13.5sp" />

            <!-- Ô nhập Họ và tên hiển thị (tùy chọn) -->
            <TextView
                android:id="@+id/tv_lbl_oauth_fullname"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="4dp"
                android:text="Họ và tên hiển thị (tùy chọn)"
                android:textColor="@color/text_secondary"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/et_oauth_fullname"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_search_box"
                android:hint="Họ và tên hiển thị (tùy chọn)"
                android:importantForAutofill="no"
                android:inputType="textPersonName"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:singleLine="true"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"
                android:textSize="13.5sp" />

            <!-- Thông báo lỗi kiểm tra hợp lệ ngay trong hộp thoại -->
            <TextView
                android:id="@+id/tv_oauth_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/danger_red"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- Hàng nút Hủy & Tiếp tục đúng chuẩn hộp thoại gốc -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="end|center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btn_oauth_cancel"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_oauth_button"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:text="Hủy"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btn_oauth_submit"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_button_primary"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingStart="22dp"
                    android:paddingEnd="22dp"
                    android:text="Tiếp tục"
                    android:textColor="@color/white"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
